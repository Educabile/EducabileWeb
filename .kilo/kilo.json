{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/claudio/EducabileWeb"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "/home/claudio/EducabileWeb"
      ]
    }
  }
}
